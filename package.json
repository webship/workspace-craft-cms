{
  "name": "@webship.co/workspace-craft-cms",
  "version": "1.0.7",
  "description": "Craft CMS for Webship Workspace: the builder (`cmd-craft-cms-project.sh`) and the craft console tool in every sites folder, the default account of the free Solo edition, the Craft CMS step pack wired into the testing setup, and two AI agents in the AI Agents folder.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-craft-cms.git"
  },
  "files": [
    "dist/src",
    "agents",
    "commands",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "craft-cms",
    "label": "Craft CMS",
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-craft-cms-project.sh",
        "commands/cmd-tools-craft-cms-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-craft-cms.sh"
      ],
      "args": [
        "scripts/args/arg-craft-cms.sh",
        "scripts/args/arg-craft-cms-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "agents/craft-cms-site-builder.md",
        "agents/craft-cms-tester.md"
      ]
    },
    "features": [
      "features/craft-cms.feature"
    ]
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
