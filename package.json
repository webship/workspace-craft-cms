{
  "name": "@webship.co/workspace-craft-cms",
  "version": "1.0.12",
  "description": "Craft CMS for Webship Workspace: the builder (`cmd-craft-cms-project.sh`) and the craft console tool in every sites folder, the default account of the free Solo edition, the Craft CMS step pack wired into the testing setup, and its AI items in their folders: two agents, a skill, a command and a prompt.",
  "main": "dist/src/index.js",
  "types": "dist/src/index.d.ts",
  "license": "ISC",
  "engines": {
    "node": ">=24"
  },
  "repository": {
    "type": "git",
    "url": "https://github.com/webship/workspace-craft-cms.git"
  },
  "files": [
    "dist/src",
    "ai",
    "commands",
    "docs",
    "features",
    "scripts",
    "testing",
    "README.md"
  ],
  "scripts": {
    "build": "tsc -p tsconfig.json",
    "prepare": "npm run build",
    "test": "npm run build && node --test dist/tests/*.test.js",
    "lint": "tsc -p tsconfig.json --noEmit"
  },
  "workspacePlugin": {
    "name": "craft-cms",
    "label": "Craft CMS",
    "needs": [
      [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "ai-agents",
      "ai-skills",
      "ai-commands",
      "ai-prompts"
    ],
    "commands": {
      "types": [
        "sites"
      ],
      "workspaces": [
        "dev",
        "test",
        "sandboxes",
        "demos"
      ],
      "files": [
        "commands/cmd-craft-cms-project.sh",
        "commands/cmd-tools-craft-cms-cli.sh"
      ]
    },
    "scripts": {
      "functions": [
        "scripts/functions/fun-craft-cms.sh"
      ],
      "args": [
        "scripts/args/arg-craft-cms.sh",
        "scripts/args/arg-craft-cms-cli.sh"
      ],
      "machine": [
        "testing/site.feature"
      ]
    },
    "ai": {
      "agents": [
        "ai/agents/craft-cms-site-builder.md",
        "ai/agents/craft-cms-tester.md"
      ],
      "skills": [
        "ai/skills/craft-cms-scenarios"
      ],
      "commands": [
        "ai/commands/craft-cms-test.md"
      ],
      "prompts": [
        "ai/prompts/craft-cms-build-and-test.md"
      ]
    },
    "features": [
      "features/craft-cms.feature",
      "features/craft-cms-runtimes.feature"
    ],
    "featuresSite": "cmd-craft-cms-project.sh ci-craft-cms --install --add-users --runtime docker"
  },
  "devDependencies": {
    "@types/node": "^24.0.0",
    "@webship.co/workspace-plugin-api": "^1.0.7",
    "typescript": "^5.9.0"
  },
  "publishConfig": {
    "access": "public"
  }
}
